# Copia este archivo como .env y pon tus valores. .env no se sube a git.
# Token público de Mapbox (empieza con pk.): https://account.mapbox.com/access-tokens/
# Sin token el mapa usa MapLibre con teselas libres de CARTO y los trayectos van en línea recta.
NEXO_MAPBOX_TOKEN=pk.tu_token_de_mapbox

# Dónde están físicamente las cámaras del equipo (lat,lng), para que el trayecto en el mapa
# corresponda al lugar real. Por defecto: tres puntos cercanos dentro del Tec de Nuevo León.
# NEXO_CAMERA_LATLNG=25.67750,-100.25970      # laptop  (CAM-008)
# NEXO_CAMERA_2_LATLNG=25.67790,-100.25860    # USB     (CAM-007)
# NEXO_CAMERA_3_LATLNG=25.67860,-100.25730    # celular (CAM-004)

# Segundos que se conservan antes y después de una frase de auxilio (video, audio y fotos).
# NEXO_EVIDENCE_PRE_SECONDS=5
# NEXO_EVIDENCE_POST_SECONDS=5

# Cámaras y micrófono se encienden solos al iniciar NEXO. false para desactivarlo en este equipo.
# NEXO_CAMERA_AUTOSTART=true

# Base de datos local (SQLite, sin Docker). 0 para trabajar sólo en memoria.
# NEXO_LOCAL_DB=1
# NEXO_LOCAL_DB_PATH=data/nexo.db

# Base compartida del equipo (PostgreSQL, opcional). En las máquinas que no son el anfitrión:
# DATABASE_URL=dbname=db_desaparecidos user=admin password=mi_password_seguro host=<IP_DEL_ANFITRION> port=5432
